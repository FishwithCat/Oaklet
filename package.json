{
  "name": "oaklet-root",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir packages/desktop dev",
    "build": "pnpm --dir packages/desktop build",
    "fetch:node": "node packages/core/scripts/fetch-node-sidecar.mjs",
    "tauri": "pnpm --dir packages/desktop tauri",
    "test:release": "node --test scripts/release/*.test.mjs",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .gitmessage || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4"
  }
}
