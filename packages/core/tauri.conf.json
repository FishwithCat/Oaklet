{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oaklet",
  "version": "0.3.0",
  "identifier": "com.oaklet.desktop",
  "build": {
    "beforeDevCommand": "node core/scripts/fetch-node-sidecar.mjs && pnpm --dir desktop run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node core/scripts/fetch-node-sidecar.mjs && pnpm --dir architecture-helper run build && pnpm --dir desktop run build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oaklet",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/oaklet-node"],
    "resources": {
      "../architecture-helper/dist": "architecture-helper"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libssl3t64"
        ]
      }
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCMzM2MjVGOUEwMjdGNTUKUldSVmZ3S2FYMkl6eTF3dWF3VUhYMTFZZDNLeVVjdlhCOUpsdGk1b3NpK2VlRHptUlBJdmVwU3gK",
      "endpoints": [
        "https://github.com/FishwithCat/Oaklet/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
